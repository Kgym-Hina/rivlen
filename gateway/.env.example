RIVLEN_BIND=127.0.0.1
RIVLEN_PORT=8787
RIVLEN_NODE_RED_URL=http://host.docker.internal:1880
RIVLEN_PUBLIC_URL=
RIVLEN_PAIRING_PASSWORD=

# Keep RIVLEN_BIND on 127.0.0.1 when using a TLS reverse proxy.
# For direct HTTPS access, set these to files under ./certs and set RIVLEN_BIND=0.0.0.0.
RIVLEN_TLS_CERT=
RIVLEN_TLS_KEY=

# Node-RED Admin API authentication (default mode: admin).
# RIVLEN_NODE_RED_TOKEN=
# RIVLEN_NODE_RED_USERNAME=
# RIVLEN_NODE_RED_PASSWORD=

# For the Home Assistant Community Node-RED App's direct port, use Home Assistant credentials:
# RIVLEN_NODE_RED_AUTH_MODE=basic
